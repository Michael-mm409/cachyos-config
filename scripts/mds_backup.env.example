# ==============================================================================
# MDS BACKUP CONFIGURATION (TEMPLATE)
# Copy this file to 'mds_backup.env' and fill in your actual environment details.
# ==============================================================================

# --- LOCAL PATHS ---
SOURCE="/path/to/local/source/directory/"
SNAPSHOT_ROOT="/path/to/local/snapshots"
LOCAL_VAULT="/path/to/external/usb/vault/"
EXCLUDES="$HOME/scripts/rsync-excludes.txt"
STATUS_FILE="/path/to/sync_status.txt"

# --- REMOTE SSH CREDENTIALS ---
REMOTE_USER="your_username"
SSH_KEY="$HOME/.ssh/your_id_ed25519_key"

# --- TARGET HOST (Tailscale MagicDNS / Hostname) ---
REMOTE_HOST="ubuntu-server"
REMOTE_PATH="/home/your_username/remote_directory/"

# --- REMOTE EXECUTION SCRIPTS ---
REMOTE_SYNC_SCRIPT="/home/your_username/scripts/global_lab_sync.sh"
